# Environment Variables - Backend

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/coaching_db"

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated URLs)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="24h"

# Email Configuration (Gmail)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-specific-password"
EMAIL_FROM="noreply@coachingplatform.com"

# Google Calendar Configuration
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URL="http://localhost:3000/google-calendar/callback"

# Coach Information
COACH_NAME="Malak Labidi"
COACH_TITLE="Professional Life Coach"
COACH_EMAIL="Coach.malak@lamethodedeleveil.com"
COACH_PHONE="+21623449539"
WHATSAPP_PHONE_NUMBER="+21623449539"
COACH_BIO="With 10+ years of experience in coaching, I help professionals achieve their personal and career goals."
COACH_PHOTO_URL="https://via.placeholder.com/500x600?text=Professional+Coach"
COACH_EXPERTISE="Career Development, Personal Growth, Executive Coaching, Leadership"
COACH_EXPERIENCE_YEARS=10
COACH_CERTIFICATIONS="ICF Certified Coach, Professional Development Specialist"

# Session Configuration
SESSION_DURATION_MINUTES=60
SESSION_BUFFER_MINUTES=15

# Admin Credentials (Default)
