# ==========================
# Database Configuration
# ==========================
DATABASE_URL="postgresql://user:password@localhost:5432/coaching_db"

# ==========================
# Server Configuration
# ==========================
PORT=3000
NODE_ENV=development

# ==========================
# JWT Authentication
# ==========================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRATION="24h"

# ==========================
# Google Calendar Configuration
# ==========================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URL="http://localhost:3000/auth/google/callback"
GOOGLE_CALENDAR_ID="primary"

# ==========================
# Email Configuration (Gmail SMTP)
# ==========================
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@coachingplatform.com"

# ==========================
# WhatsApp Configuration (Twilio)
# ==========================
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
WHATSAPP_PHONE_NUMBER="+21623449539"
WHATSAPP_MESSAGE_TEMPLATE="Hello, I would like to know more about your coaching services."

# ==========================
# Coach Information (Easily Customizable)
# ==========================
COACH_NAME="Malak Labidi"
COACH_TITLE="Professional Life Coach"
COACH_EMAIL="Coach.malak@lamethodedeleveil.com"
COACH_PHONE="+21623449539"
COACH_WHATSAPP="+21623449539"
COACH_BIO="Experienced professional coach specialized in personal development and career coaching."
COACH_PHOTO_URL="https://via.placeholder.com/400x400?text=Coach"
COACH_EXPERTISE="Career Coaching,Personal Development,Executive Coaching"
COACH_EXPERIENCE_YEARS=10
COACH_CERTIFICATIONS="ICF Certified Coach,Professional Development Specialist"

# ==========================
# Application Settings
# ==========================
SESSION_DURATION_MINUTES=60
SESSION_BUFFER_MINUTES=15
BOOKING_CONFIRMATION_TEMPLATE="session-confirmation"
NOTIFICATION_ENABLED=true
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ==========================
# Admin Credentials (Change in Production!)
# ==========================
ADMIN_EMAIL="Coach.malak@lamethodedeleveil.com"
ADMIN_PASSWORD="Admin@123456"
